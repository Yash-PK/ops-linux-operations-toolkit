#!/usr/bin/env bash
# Resolve the repository without requiring installation or a sibling checkout.
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${repo_root}/src"
if [[ -n "${PYTHON:-}" ]]; then
  toolkit_python="$PYTHON"
elif [[ -x "${repo_root}/.venv/bin/python" ]]; then
  toolkit_python="${repo_root}/.venv/bin/python"
else
  toolkit_python=python3
fi
if ! "$toolkit_python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 2)'; then
  printf '%s\n' 'ops-toolkit requires Python >=3.11; run make bootstrap or set PYTHON.' >&2
  exit 2
fi
exec "$toolkit_python" -m ops_toolkit.cli "$@"
